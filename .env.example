# --- LLM provider config -----------------------------------------------
# Roastly calls the LLM through a small provider abstraction (src/lib/llm/),
# so swapping providers later just means changing these values plus adding
# a new file under src/lib/llm/ that matches the same interface.

# Which provider to use. Currently only "nvidia" is implemented.
LLM_PROVIDER=nvidia

# Nvidia's hosted inference API is OpenAI-compatible.
# Base URL — do not include a trailing slash or /chat/completions.
LLM_ENDPOINT=https://integrate.api.nvidia.com/v1

# Get a free API key at https://build.nvidia.com (sign in, pick a model,
# click "Get API Key").
LLM_API_KEY=nvapi-REPLACE_ME

# Default model. meta/llama-3.3-70b-instruct is a good quality/cost balance
# on Nvidia's free tier. Swap to a smaller model (e.g.
# meta/llama-3.1-8b-instruct) if you hit rate limits or want faster replies.
LLM_MODEL=meta/llama-3.3-70b-instruct

# --- App config -----------------------------------------------------------

# Public URL of the deployed app, used to build the "Share on X" tweet link.
# Set this to your Vercel/Cloudflare URL once deployed; localhost is fine
# for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
